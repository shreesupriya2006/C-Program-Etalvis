#include <stdio.h>
int memcomp(int *src,int *dst,int size);
int main()
{
    int size,i,*src,*dst;
    scanf("%d",&size);
    int a[size],b[size];
    for(i=0;i<size;i++)
        scanf("%d",&a[i]);
    for(i=0;i<size;i++)
        scanf("%d",&b[i]);
    src=&a[0];
    dst=&b[0];
    if(memcomp(src,dst,size))
        printf("Success");
    else
        printf("Failure");

}
int memcomp(int *src,int *dst,int size)
{
    int i;
    for(i=0;i<size;i++){
        if(*src!=*dst)
        return 0;
    }
    return 1;
}
