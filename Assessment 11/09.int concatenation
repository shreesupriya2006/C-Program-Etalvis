#include <stdio.h>
void intcon(int *p1 ,int size1,int *p2,int size2,int *p3);
int main()
{
    int s1,s2,i;
    scanf("%d %d",&s1,&s2);
    int a[s1],b[s2],c[s1+s2];
    for(i=0;i<s1;i++)
    scanf("%d",&a[i]);
    for(i=0;i<s2;i++)
    scanf("%d",&b[i]);
    int *p1,*p2,*p3;
    p1=&a[0];
    p2=&b[0];
    p3=&c[0];
    intcon(a,s1,b,s2,c);
    for(i=0;i<s1+s2;i++)
    printf("%d ",c[i]);
}
void intcon(int *p1 ,int size1,int *p2,int size2,int *p3)
{
    int i;
    for(i=0;i<size1+size2;i++)
    {
        if(i<size1)
        {
            *p3=*p1;
            p3++;
            p1++;
        }
        else
        {
            *p3=*p2;
            p3++;
            p2++;
        }
    }
}
