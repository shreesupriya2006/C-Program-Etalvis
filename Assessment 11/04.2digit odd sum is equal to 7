#include <stdio.h>
int find_2digit_odd_sum7(int *);
int main()
{
    int n,*p;
    p=&n;
    for(n=11;n<100;n=n+2)
    {
       if(find_2digit_odd_sum7(p))
        printf("%d ",n);
    }
}
int find_2digit_odd_sum7(int *p1)
{
    int num=*p1;
    if(num%2==1)
    {
        int n1=num/10;
        int n2=num%10;
        if(n1+n2==7)
            return 1;
    }
    return 0;
}
