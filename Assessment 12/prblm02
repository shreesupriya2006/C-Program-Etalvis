//get a string and a character and print where the character occured in that string (index)
#include <stdio.h>
#include <string.h>
int main()
{
    int n;
    scanf("%d",&n);
    char a,arr[n];
    //fgets(arr,n,stdin);
    scanf("%s",arr);
    scanf(" %c",&a);
    for(int i=0;i<n;i++)
    {
        if(arr[i]==a)
            printf("%d ",i+1);
    }
}
