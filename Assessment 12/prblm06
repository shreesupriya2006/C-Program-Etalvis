#include<stdio.h>
#include<string.h>

int main()
{
    char exp[120];
    char a[60],b[60],op;
    long long n1,n2;
    int i,j;

    while(1)
    {
        printf("Calc> ");
        scanf("%s",exp);

        if(strcmp(exp,"Exit")==0)
            break;

        i=0;
        j=0;

        while(exp[i]>='0'&&exp[i]<='9')
            a[j++]=exp[i++];

        a[j]='\0';

        op=exp[i++];

        j=0;
        while(exp[i]!='\0')
            b[j++]=exp[i++];

        b[j]='\0';

        n1=0;
        n2=0;

        for(i=0;a[i]!='\0';i++)
            n1=n1*10+(a[i]-'0');

        for(i=0;b[i]!='\0';i++)
            n2=n2*10+(b[i]-'0');

        if(op=='+')
            printf("%lld\n",n1+n2);
        else if(op=='-')
            printf("%lld\n",n1-n2);
        else if(op=='*')
            printf("%lld\n",n1*n2);
        else if(op=='/')
            printf("Quotient:%lld Remainder:%lld\n",n1/n2,n1%n2);
    }
}
